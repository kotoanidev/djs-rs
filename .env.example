# Copy to `.env` (git-ignored) and fill in. Used only for running examples locally (D-034).
DISCORD_TOKEN=your-test-bot-token
# Optional: a channel in your test guild for examples that send messages.
DISCORD_TEST_CHANNEL_ID=
# Optional: the test guild where the examples register their slash commands (default: the
# first guild the bot is in).
DISCORD_TEST_GUILD_ID=
# Optional: a webhook URL the `advanced` example announces its start through.
DISCORD_WEBHOOK_URL=
